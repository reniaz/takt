{
  "name": "takt",
  "productName": "Takt",
  "version": "1.2.0",
  "description": "A music player for Windows",
  "license": "MIT",
  "author": "reniaz",
  "type": "module",
  "main": "electron/dist/main.cjs",
  "engines": {
    "node": "^24.11 || ^26"
  },
  "scripts": {
    "dev": "npm run build:shell && concurrently -k -n vite,electron -c cyan,yellow \"npm run dev:web\" \"wait-on -t 60000 http://localhost:5273 && electron electron/dist/main.cjs\"",
    "dev:web": "vite",
    "dev:shell": "tsup --config electron/tsup.config.ts --watch",
    "start": "cross-env TAKT_FORCE_PROD_RENDERER=1 electron .",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build:renderer": "vite build",
    "build:shell": "tsup --config electron/tsup.config.ts",
    "build": "npm run build:renderer && npm run build:shell",
    "verify": "npm run check && npm run test",
    "package": "npm run build && electron-builder --win nsis",
    "check:app": "node tools/check-app.mjs",
    "icon": "node tools/build-icon.mjs",
    "bootstrap": "node tools/bootstrap-repo.mjs",
    "release": "node tools/release.mjs",
    "clean": "node tools/clean-release.mjs"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "music-metadata": "^11.14.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "@parcel/watcher": false,
    "electron-winstaller": false,
    "electron@43.3.0": true
  }
}
